  {
   "k": "text",
   "t": "@Component - IconComponent"
  },
  {
   "k": "p",
   "t": "IconComponent is intended only for use with icons used with an icon sprite. \nStandalone icons from @visa/nova-icons-angular is recommended over using the IconComponent.. \nIcon component for displaying icons from VPDS' Icon Library."
  },
  {
   "k": "text",
   "t": "[v-icon]"
  },
  {
   "k": "table",
   "rows": [
    [
     "Name",
     "Decorator type",
     "Default value",
     "Type",
     "Description",
     "Built inBuilt in properties are set by the Nova Angular component itself or by its parent. These properties are generally not needed to be set or edited."
    ],
    [
     "customHeight",
     "@Input()",
     "'8'",
     "string",
     "Set CSS variable --v-icon-height which customizes icon height. isBadgeEllipse must be true for this to have an affect.",
     "false"
    ],
    [
     "customIcon",
     "@Input()",
     "",
     "string",
     "Name of custom icon reference. Should refer to an icon within an icon sprite in your application. The href will reference the string provided directly. No library or iconSize will be added.",
     "false"
    ],
    [
     "customWidth",
     "@Input()",
     "'8'",
     "string",
     "Set CSS variable --v-icon-width which customizes icon width. isBadgeEllipse must be true for this to have an affect.",
     "false"
    ],
    [
     "iconInput",
     "@Input()",
     "",
     "null | string",
     "Name of icon to display. Should refer to an icon in VPDS' Icon Library.",
     "false"
    ],
    [
     "iconSize",
     "@Input()",
     "'tiny' / IconSize.TINY",
     "IconSize",
     "Sets icon resolution/size.",
     "false"
    ],
    [
     "isBadgeEllipse",
     "@Input()",
     "false",
     "boolean, unknown",
     "Sets icon to badge-ellipse variant when true. Intended for use in badges with an indicator.",
     "false"
    ],
    [
     "library",
     "@Input()",
     "'visa' / IconLibrary.VISA",
     "IconLibrary",
     "Tells icon which library to reference.",
     "false"
    ],
    [
     "rtl",
     "@Input()",
     "false",
     "boolean, unknown",
     "Flips icon from right to left when true and dir=\"rtl\" is present on a parent element.",
     "false"
    ]
   ]
  },
